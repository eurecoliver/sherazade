# ============================================
# DJANGO
# ============================================
DJANGO_SECRET_KEY=change-me-use-long-random-string-50-chars-minimum
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# DATABASE
# ============================================
POSTGRES_DB=sherazade
POSTGRES_USER=sherazade
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# MINIO (S3-compatible storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
USE_S3=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_STORAGE_BUCKET_NAME=sherazade-media
AWS_S3_ENDPOINT_URL=http://minio:9000
# URL esterno di MinIO raggiungibile dal browser (porta 9000 esposta su Hetzner)
AWS_S3_ENDPOINT_URL_EXTERNAL=http://159.69.9.230:9000

# ============================================
# JWT
# ============================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================
# EMAIL
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@sherazade.it
EMAIL_HOST_PASSWORD=change-me-email-password
DEFAULT_FROM_EMAIL=Sherazade <noreply@sherazade.it>

# ============================================
# NEXT.JS / AUTH
# ============================================
# BACKEND_URL: usato dalle API routes Next.js server-side (container Docker)
# Il browser NON chiama mai il backend direttamente — usa sempre /api/* (Next.js proxy)
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://backend:8000
NEXTAUTH_SECRET=change-me-generate-random-32-chars
NEXTAUTH_URL=http://localhost:3000

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# MEDIA & GDPR
# ============================================
MEDIA_AUTO_DELETE_DAYS=365
